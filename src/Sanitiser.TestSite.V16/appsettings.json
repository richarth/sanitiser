{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "0e62807f-411c-4003-8998-7cd9a7574505",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeManual",
        "IncludeVersionNumberInGeneratedModels": false
      },
      "Unattended": {
        "UpgradeUnattended": true,
        "InstallUnattended": true,
        "UnattendedUserName": "Admin",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "lA4&DyZjnpp"
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Sanitiser": {
    "Enable": true,
    "Replacement": {
      "EmailTemplate": "user{index}@example.com",
      "NameTemplate": "user{index}",
      "UserNameTemplate": "user{index}"
    },
    "MembersSanitiser": {
      "Enable": true,
      "DomainsToExclude": "yourcompany.com,yourpartner.com",
      "Mode": "Anonymise"
    },
    "UsersSanitiser": {
      "Enable": true,
      "DomainsToExclude": "yourcompany.com,yourpartner.com",
      "Mode": "Anonymise"
    },
    "FormsSanitiser": {
      "Enable": true
    }
  }
}
