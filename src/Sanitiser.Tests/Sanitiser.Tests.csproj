<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10.0 so the suite can reference Sanitiser.AI (net10-only). The logic under test is
         framework-agnostic, so a single TFM is sufficient for these unit tests. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- Real SQLite for integration tests of the EF Core cache-instruction cleanup. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sanitiser.Core\Sanitiser.Core.csproj" />
    <ProjectReference Include="..\Sanitiser\Sanitiser.csproj" />
    <ProjectReference Include="..\Sanitiser.Faker\Sanitiser.Faker.csproj" />
    <ProjectReference Include="..\Sanitiser.AI\Sanitiser.AI.csproj" />
  </ItemGroup>

</Project>
