<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Product>Umbraco.Community.Sanitiser.Forms</Product>
    <PackageId>Umbraco.Community.Sanitiser.Forms</PackageId>
    <Title>Sanitiser Forms</Title>
    <Description>When enabled, this package deletes Umbraco Forms submissions and their uploaded files from your Umbraco website on startup. Part of the Sanitiser package family.</Description>
    <RootNamespace>Umbraco.Community.Sanitiser.Forms</RootNamespace>
    <AssemblyName>Umbraco.Community.Sanitiser.Forms</AssemblyName>
  </PropertyGroup>

  <!-- Umbraco.Forms.Core is versioned per target framework in ../Directory.Packages.props to match the Umbraco
       major of each framework (Forms 13 on .NET 8, 16 on .NET 9, 17/18 on .NET 10). -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Umbraco.Forms.Core" />
    <ProjectReference Include="..\Sanitiser.Core\Sanitiser.Core.csproj" />
  </ItemGroup>

  <!-- On .NET 9, Core's CMS floor is 15 but Umbraco Forms has no 15 (it jumped 13 -> 16), so Forms 16 needs
       CMS 16. Raise the CMS floor to 16 for this package on this framework to keep the graph consistent. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" VersionOverride="[16.0.0,17)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings-schema.Sanitiser.Forms.json">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="buildTransitive\**" PackagePath="buildTransitive"/>
  </ItemGroup>

</Project>
