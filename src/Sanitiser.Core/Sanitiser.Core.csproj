<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <ContentTargetFolders>.</ContentTargetFolders>
    <Product>Umbraco.Community.Sanitiser.Core</Product>
    <PackageId>Umbraco.Community.Sanitiser.Core</PackageId>
    <Title>Sanitiser Core</Title>
    <Description>Core interfaces and orchestration for the Sanitiser package family. Provides the ISanitiser extension point, auto-discovery, and base classes for building sanitisation strategies for Umbraco.</Description>
    <RootNamespace>Umbraco.Community.Sanitiser</RootNamespace>
    <AssemblyName>Umbraco.Community.Sanitiser.Core</AssemblyName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
  </ItemGroup>

  <!-- Umbraco 13 for .NET 8 sites, Umbraco 15/16 for .NET 9 sites, Umbraco 17/18 for .NET 10 sites.
       Persistence.EFCore transitively provides Umbraco.Cms.Core, Infrastructure,
       and the EF Core SqlServer/Sqlite providers for the matching EF Core major. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="[13.0.0,14)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="[15.0.0,17)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="[17.0.0,19)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings-schema.Sanitiser.json">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="buildTransitive\**" PackagePath="buildTransitive"/>
  </ItemGroup>

</Project>
