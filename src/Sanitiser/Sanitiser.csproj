<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Product>Umbraco.Community.Sanitiser</Product>
    <PackageId>Umbraco.Community.Sanitiser</PackageId>
    <Title>Sanitiser</Title>
    <Description>When enabled, this package will automatically remove personal data from your Umbraco website on startup. Meta-package that installs all Sanitiser strategy packages.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- Meta-package: no assembly, only dependencies on the strategy packages -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sanitiser.Users\Sanitiser.Users.csproj" />
    <ProjectReference Include="..\Sanitiser.Members\Sanitiser.Members.csproj" />
  </ItemGroup>

</Project>
