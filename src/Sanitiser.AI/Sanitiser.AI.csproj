<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10.0 only: Umbraco.AI ships for Umbraco 17.4+/18 (.NET 10) only. -->
    <TargetFramework>net10.0</TargetFramework>
    <Product>Umbraco.Community.Sanitiser.AI</Product>
    <PackageId>Umbraco.Community.Sanitiser.AI</PackageId>
    <Title>Sanitiser AI</Title>
    <Description>Replaces personal data with values generated by Umbraco AI. Requires Umbraco.AI to be installed and configured with a chat connection and profile. Umbraco 17.4+ / 18 (.NET 10) only.</Description>
    <RootNamespace>Umbraco.Community.Sanitiser</RootNamespace>
    <AssemblyName>Umbraco.Community.Sanitiser.AI</AssemblyName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Spans the Umbraco 17.x and 18.x Umbraco.AI lines; the chat API is identical across both. -->
    <PackageReference Include="Umbraco.AI.Core" Version="[17.1.1,19)" />
    <ProjectReference Include="..\Sanitiser.Core\Sanitiser.Core.csproj" />
  </ItemGroup>

</Project>
