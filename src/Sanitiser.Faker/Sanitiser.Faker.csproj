<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Product>Umbraco.Community.Sanitiser.Faker</Product>
    <PackageId>Umbraco.Community.Sanitiser.Faker</PackageId>
    <Title>Sanitiser Faker</Title>
    <Description>Replaces personal data with realistic fake values generated by Bogus. Install alongside the Sanitiser packages to anonymise with lifelike names, emails and usernames instead of templated values.</Description>
    <RootNamespace>Umbraco.Community.Sanitiser</RootNamespace>
    <AssemblyName>Umbraco.Community.Sanitiser.Faker</AssemblyName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="[35.6.5,36)" />
    <ProjectReference Include="..\Sanitiser.Core\Sanitiser.Core.csproj" />
  </ItemGroup>

</Project>
